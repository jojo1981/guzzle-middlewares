{
  "name": "jojo1981/guzzle-middlewares",
  "description": "This library contains a collection of guzzle middlewares.",
  "keywords": [
    "guzzle",
    "middleware",
    "middlewares",
    "logger",
    "logs",
    "event",
    "events",
    "dispatcher",
    "capture"
  ],
  "type": "library",
  "license": "MIT",
  "readme": "README.md",
  "authors": [
    {
      "name": "Joost Nijhuis",
      "email": "jnijhuis81@gmail.com"
    }
  ],
  "prefer-stable": true,
  "minimum-stability": "stable",
  "require": {
    "php": "^8.1",
    "ext-json": "*",
    "guzzlehttp/guzzle": "^6.0|^7.0",
    "psr/log": "^1.0|^2.0|^3.0",
    "symfony/event-dispatcher": "^4.0|^5.0|^6.0|^7.0|^8.0",
    "symfony/filesystem": "^4.0|^5.0|^6.0|^7.0|^8.0"
  },
  "autoload": {
    "psr-4": {
      "Jojo1981\\GuzzleMiddlewares\\": "src/"
    }
  },
  "require-dev": {
    "dg/bypass-finals": "^1.0",
    "phpspec/prophecy-phpunit": "^2.4",
    "phpunit/phpunit": "^10.0|^11.0|^12.0"
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\Jojo1981\\GuzzleMiddlewares\\": "tests/"
    }
  },
  "config": {
    "bin-dir": "bin",
    "sort-packages": true
  },
  "scripts": {
    "test": [
      "./bin/phpunit"
    ]
  }
}
